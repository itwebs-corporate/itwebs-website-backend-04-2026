# Add this location inside the existing HTTPS server block.
location = /github-webhook {
    limit_except POST { deny all; }
    client_max_body_size 1m;
    proxy_pass http://127.0.0.1:8765/github-webhook;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
}

# OAuth redirect from amoCRM into the backend. Keep it in the itwebs.ru HTTPS server block.
location = /api/integrations/amocrm/callback {
    access_log off;
    proxy_pass http://127.0.0.1:9999/api/integrations/amocrm/callback;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# amoCRM external integration secrets webhook. Public HTTPS endpoint; state is validated by the backend.
location = /api/integrations/amocrm/secrets {
    access_log off;
    limit_except POST { deny all; }
    client_max_body_size 16k;
    proxy_pass http://127.0.0.1:9999/api/integrations/amocrm/secrets;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Admin-authenticated HTML page with amoCRM's external integration button.
location = /api/admin/integrations/amocrm/authorize {
    proxy_pass http://127.0.0.1:9999/api/admin/integrations/amocrm/authorize;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
